{
  "zarr_format": 3,
  "node_type": "array",
  "dimension_names": ["time", "y", "x"],
  "attributes": {
    "zarr_conventions": [
      {
        "schema_url": "https://raw.githubusercontent.com/zarr-conventions/cf/refs/tags/v1/schema.json",
        "spec_url": "https://github.com/zarr-conventions/cf/blob/v1/README.md",
        "uuid": "0c0a02d2-8a95-4303-8b62-16a50b439d74",
        "name": "cf",
        "description": "CF semantic metadata — standard names, units, axis, calendar, and data-quality attributes — for Zarr data variables and coordinates."
      },
      {
        "schema_url": "https://raw.githubusercontent.com/zarr-conventions/coords/refs/tags/v1/schema.json",
        "spec_url": "https://github.com/zarr-conventions/coords/blob/v1/README.md",
        "uuid": "6ca4454a-658a-4348-a667-b39ced0e58cb",
        "name": "coords",
        "description": "Domain-agnostic mapping between Zarr array index space and coordinate space."
      }
    ],
    "coords:coordinates": {
      "time": {
        "type": "array",
        "path": "../time",
        "cf:attributes": {
          "standard_name": "time",
          "units": "days since 1850-01-01",
          "calendar": "noleap",
          "axis": "T"
        }
      },
      "y": {
        "type": "reference",
        "convention": "spatial",
        "cf:attributes": {
          "standard_name": "projection_y_coordinate",
          "units": "m",
          "axis": "Y"
        }
      },
      "x": {
        "type": "reference",
        "convention": "spatial",
        "cf:attributes": {
          "standard_name": "projection_x_coordinate",
          "units": "m",
          "axis": "X"
        }
      }
    },
    "cf:attributes": {
      "standard_name": "sea_water_temperature",
      "long_name": "sea water temperature",
      "units": "K",
      "valid_range": [270.0, 320.0],
      "ancillary_variables": "sea_water_temperature_qc"
    },
    "cf:version": 1
  }
}
